# Скопируйте в .env и поправьте при необходимости — docker-compose.yml
# читает эти переменные, а значения по умолчанию в самом compose-файле
# совпадают с этими же, так что для локального запуска .env не обязателен.

# --- Postgres ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=avito_kitchen

# --- Core API (cmd/api) ---
HTTP_PORT=8080

# --- Mock Restaurant (cmd/mock-restaurant) ---
MOCK_HTTP_PORT=8081
# Заведение, которое эмулирует сервис — должно существовать в seed-данных
# (migrations/000002_seed_data.up.sql), 1 = "Додо Пицца".
RESTAURANT_ID=1
# Как часто опрашивать Core API на предмет новых заказов.
POLL_INTERVAL=5s
# Пауза перед каждым шагом конвейера статусов (ACCEPTED -> COOKING -> ...).
STAGE_DELAY=5s
